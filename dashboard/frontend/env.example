# Marin Pest Control Dashboard - Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API base URL
VITE_API_BASE_URL="http://localhost:5000"
# In production, set this to your backend domain (e.g., "https://api.yourdomain.com")

# ===========================================
# STACK AUTH CONFIGURATION
# ===========================================
# Stack Auth project configuration for frontend
VITE_STACK_AUTH_URL="https://api.stack-auth.com"
VITE_STACK_PROJECT_ID="5fb1ffdb-d2a3-4a10-8824-7cfd62ab0f06"
VITE_STACK_PUBLISHABLE_CLIENT_KEY="pck_h8mejt0bh4277fgzhc0r0ap5w2dx6a2y3bz74dngp70r0"

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Development mode flags
VITE_DEV_MODE="true"
VITE_MOCK_AUTH="true"
# Set to "false" in production

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# App name and version
VITE_APP_NAME="Marin Pest Control Dashboard"
VITE_APP_VERSION="2.0.0"

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable/disable features
VITE_ENABLE_DEBUG_MODE="true"
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_ERROR_REPORTING="false"

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Google Analytics (if enabled)
VITE_GA_TRACKING_ID=""
# Sentry error reporting (if enabled)
VITE_SENTRY_DSN=""

# ===========================================
# QUICKBOOKS INTEGRATION
# ===========================================
# QuickBooks integration settings
VITE_QBO_ENABLED="true"
VITE_QBO_SANDBOX_MODE="true"
# Set to "false" for production QuickBooks

# ===========================================
# UI CONFIGURATION
# ===========================================
# Theme and UI settings
VITE_DEFAULT_THEME="light"
VITE_ENABLE_DARK_MODE="true"
VITE_ITEMS_PER_PAGE="50"

# ===========================================
# CACHING CONFIGURATION
# ===========================================
# TanStack Query cache settings
VITE_QUERY_STALE_TIME="300000"
# 5 minutes in milliseconds
VITE_QUERY_CACHE_TIME="600000"
# 10 minutes in milliseconds
